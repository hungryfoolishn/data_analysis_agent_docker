# DeepSeek API（必填）
# 在 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=your_api_key_here
# Required for every non-local production deployment. Generate a strong
# random token for every deployed environment.
# API_AUTH_TOKEN=change-me
# API_ENVIRONMENT=production
# Development can explicitly allow empty-token startup only for local use:
# API_ENVIRONMENT=development
# API_ALLOW_INSECURE_AUTH=true
# CORS_ALLOWED_ORIGINS=http://localhost:18501,http://127.0.0.1:18501

# 可选：覆盖默认值
# DEEPSEEK_MODEL_ID=deepseek-chat
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# ── Worker execution backend (R0a-1B) ──────────────────────────────────────
# Production default: Docker worker (container-isolated, fail-closed).
# WORKER_BACKEND=docker
# DEEPANALYZE_WORKER_IMAGE=deepanalyze-worker:1.1.0
#
# The API container needs /var/run/docker.sock access and identity binds for
# the workspace and jobs roots when running under docker-compose (see
# docker-compose.yml).
#
# DEVELOPMENT ONLY (not a sandbox): bounded child-process execution for
# untrusted (LLM-generated) code requires BOTH variables below. Never enable
# this in production.
# WORKER_BACKEND=process
# ALLOW_UNTRUSTED_PROCESS_EXECUTION=1
#
# Worker container resource limits (defaults shown):
# DEEPANALYZE_WORKER_CPU=1000000000        # 1 CPU (nanoCPUs)
# DEEPANALYZE_WORKER_MEMORY=512            # MB
# DEEPANALYZE_WORKER_PIDS=128
# DEEPANALYZE_WORKER_JOBS_ROOT=/tmp/deepanalyze-worker-jobs
