# DeepSeek API（必填）
# 在 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=your_api_key_here
# Required for every non-local production deployment. Generate a strong
# random token for every deployed environment.
# API_AUTH_TOKEN=change-me
# API_ENVIRONMENT=production
# Development can explicitly allow empty-token startup only for local use:
# API_ENVIRONMENT=development
# API_ALLOW_INSECURE_AUTH=true
# CORS_ALLOWED_ORIGINS=http://localhost:18501,http://127.0.0.1:18501

# 可选：覆盖默认值
# DEEPSEEK_MODEL_ID=deepseek-chat
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
